# Copy to .env and fill in. .env is git-ignored — never commit it.

# ---------------------------------------------------------------------------
# BACKEND ONLY (local dev server). On Supabase these are set as secrets:
#   npx supabase secrets set --env-file <file>
# NEVER prefix these with EXPO_PUBLIC_ — that would ship them inside the app.
# ---------------------------------------------------------------------------
# --- How stories and Aaji's voice reach Gemini: Vertex AI (Google Cloud) ---------
# The app MUST use Vertex AI: the Gemini API (AI Studio) terms exclude services for
# under-18s. Step-by-step setup: docs/VERTEX_SETUP.md
GOOGLE_CLOUD_PROJECT=
# "global" has the newest models
GOOGLE_CLOUD_LOCATION=global
# Local runs: path to the service-account key file, kept OUTSIDE this folder
GOOGLE_APPLICATION_CREDENTIALS=
# Supabase: the key file's contents as one line of base64 (or set VERTEX_API_KEY instead)
GOOGLE_SERVICE_ACCOUNT_JSON=
VERTEX_API_KEY=
# Secret for story/audio tokens — any long random string (e.g. `openssl rand -hex 32`)
STORY_STATE_SECRET=

# AI Studio key — developer experiments only, ignored when GOOGLE_CLOUD_PROJECT is set
GEMINI_API_KEY=

# Default model for every stage. Change to try another Gemini model.
GEMINI_MODEL=gemini-3.5-flash
# Optional per-role overrides (leave empty to use GEMINI_MODEL)
GEMINI_WRITER_MODEL=
GEMINI_CRITIC_MODEL=
# Small fast model for mechanical steps (classifier, audio direction)
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Tried in order when a model is busy or out of daily quota. "none" disables.
# Writer/critic/planner NEVER fall back to a *lite* model (quality first).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Hidden thinking time. Empty = per stage (low for planning/audio, medium for writer/critic).
# One of: minimal | low | medium | high | auto
GEMINI_THINKING=
# Text-to-speech (Aaji's voice)
TTS_VOICE=Sulafat
TTS_MODEL=gemini-3.8-flash-tts
# Empty = sensible defaults (on Vertex: gemini-3.8-flash-lite-tts, gemini-2.5-flash-tts)
TTS_FALLBACK_MODEL=
# Optional: override Aaji's base voice direction
TTS_STYLE=
# Every part of Aaji's voice is listened to before a child hears it (directions read aloud,
# extra or missing speech → rendered again, else a ready-made story plays). Leave empty.
# "off" = length check only — for diagnosis, never for the children's app.
TTS_CHECK=
# Model that listens (empty = gemini-3.5-flash-lite)
TTS_CHECK_MODEL=

# off | summary | full   (full = anonymised JSON per story in .story-logs/)
STORY_LOG=summary
# false = never return the developer trace
STORY_DEBUG=true
# Set the same random value here and as a Supabase secret: traces then go only to the QA runner.
STORY_DEBUG_TOKEN=
# One story = several short requests (Supabase stops a request at 150 s).
# STORY_SLICE_MS: don't start another AI step in the same request after this long.
# STORY_REQUEST_DEADLINE_MS: hard stop per request. STORY_TIME_BUDGET_MS: whole story.
# STORY_SLICE_MS=20000
# STORY_REQUEST_DEADLINE_MS=135000
# STORY_TIME_BUDGET_MS=360000

# ---------------------------------------------------------------------------
# APP (public values — safe to ship in the app)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional override. Empty = use the Supabase function.
# Local dev server from a phone: http://<your-mac-ip>:8787/generate-story
# Set to "mock" to force offline template stories.
EXPO_PUBLIC_STORY_API_URL=
